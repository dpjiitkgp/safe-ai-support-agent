# Basic whitespace rules every editor understands. Python formatting itself is ruff's job
# (see poc/pyproject.toml).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 110
